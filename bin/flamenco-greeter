#!/usr/bin/env python3
"""flamenco-greeter: greetd login screen for Flamenco Shell.

  flamenco-greeter --command niri|hyprland|sway [OPTIONS]   start the greeter (run by greetd)
  flamenco-greeter sync [--quiet] [--no-sudo] copy your theme, wallpaper and avatar to the login screen
  flamenco-greeter enable [niri|hyprland|sway] point greetd at flamenco-greeter (asks for sudo)
  flamenco-greeter preview [OPTIONS]          try the greeter in a window, with your current theme
      --fingerprint             simulate a fingerprint reader
      --palette NAME            try another palette (or "wallpaper")
      --mode dark|light         try the other color mode
      --wallpaper PATH          try another wallpaper
      --widgets FILE            start with this widgets.json (default: the login screen's own)
      --from DIR                take Flamenco Shell's Lock & Login settings (config.json, wallpaper,
                                avatars) and widgets from DIR (default: /var/cache/flamenco-greeter)
      --as-applied              only what Flamenco Shell's Apply sends, without your synced theme
  flamenco-greeter fingerprint status|enable|disable   fingerprint login (pam_fprintd in /etc/pam.d/greetd)
  flamenco-greeter widgets list|lock|unlock|reset      login-screen widgets (hold the background to edit)
  flamenco-greeter doctor [--json]            check everything the login screen needs (alias: check)
  flamenco-greeter users --json               login users (used by the greeter UI)
  flamenco-greeter sessions --json            installed desktop sessions (used by the greeter UI)
  flamenco-greeter fingerprint --json         reader + PAM state (used by the greeter UI)

Launcher options:
  --command COMPOSITOR      niri, hyprland or sway (required)
  -C, --config PATH         compositor config to start from (the greeter's own lines are appended)
  -p, --path DIR            greeter QML directory (default: the installed one)
  --cache-dir DIR           greeter data directory (default: /var/cache/flamenco-greeter)
  --no-save-session         don't remember the last session
  --no-save-username        don't remember the last user
  --debug                   log to stderr instead of the journal
"""

from __future__ import annotations

import grp
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "0.4.0"

SELF = Path(__file__).resolve()
DEFAULT_CACHE = Path("/var/cache/flamenco-greeter")
GREETER_USER = "greeter"
GREETD_CONFIG = Path("/etc/greetd/config.toml")
GREETD_PAM = Path("/etc/pam.d/greetd")
PAM_BEGIN = "# BEGIN flamenco-greeter fingerprint"
PAM_END = "# END flamenco-greeter fingerprint"
# One try per round, and short rounds: greetd can't interrupt pam_fprintd, so a
# password typed mid-scan waits for the round to end before it's checked. The
# greeter starts a new round itself whenever one ends (10 s is pam_fprintd's minimum).
PAM_FPRINT = "auth       sufficient   pam_fprintd.so max-tries=1 timeout=10"
FPRINT_BUS = "net.reactivated.Fprint"
NIRI_OVERRIDES = ("/usr/share/greetd/flamenco-niri.kdl", "/etc/greetd/flamenco-niri.kdl")
OTHER_DMS = ("sddm", "gdm", "lightdm", "ly", "lxdm", "xdm", "emptty", "cosmic-greeter", "plasmalogin", "lemurs")
COMPOSITORS = ("niri", "hyprland", "sway")

# Settings sections the login screen reads. Everything else in the user's
# settings.json (shortcuts, autostart, weather city…) stays in their home.
SYNCED_KEYS = {
    "general": ("use24h", "showSeconds", "avatar"),
    "appearance": None,  # all of it
    # live wallpapers (videos, GIFs) and one wallpaper per screen, as Flamenco Shell has them
    "wallpaper": ("current", "fillMode", "live", "liveSpeed", "perScreen", "screens"),
    "keyboard": ("layout", "variant", "options", "model", "repeatDelay", "repeatRate", "numlock"),
    "apps": ("cursorTheme", "cursorSize"),
}


def die(msg: str, code: int = 1) -> int:
    print(f"flamenco-greeter: {msg}", file=sys.stderr)
    return code


def greeter_dir() -> Path:
    """The Quickshell config root: env override, this checkout, or the installed copy."""
    if env := os.environ.get("FLAMENCO_GREETER_DIR"):
        return Path(env)
    dev = SELF.parent.parent / "greeter"
    if (dev / "shell.qml").exists():
        return dev
    return Path("/usr/share/flamenco-greeter/greeter")


def cache_dir() -> Path:
    return Path(os.environ.get("FLAMENCO_GREETER_CACHE") or DEFAULT_CACHE)


def qs_bin() -> str | None:
    return shutil.which("qs") or shutil.which("quickshell")


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def env_bool(name: str, default: bool) -> bool:
    v = os.environ.get(name, "").strip().lower()
    if v in ("1", "true", "yes", "on"):
        return True
    if v in ("0", "false", "no", "off"):
        return False
    return default


# ── users ──

def login_defs() -> tuple[int, int]:
    lo, hi = 1000, 60000
    try:
        for line in Path("/etc/login.defs").read_text().splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[0] == "UID_MIN":
                lo = int(parts[1])
            elif len(parts) >= 2 and parts[0] == "UID_MAX":
                hi = int(parts[1])
    except (OSError, ValueError):
        pass
    return lo, hi


def login_shells() -> set[str]:
    try:
        return {l.strip() for l in Path("/etc/shells").read_text().splitlines() if l.strip() and not l.startswith("#")}
    except OSError:
        return set()


def list_users(cache: Path) -> list[dict]:
    lo, hi = login_defs()
    shells = login_shells()
    out = []
    for pw in pwd.getpwall():
        if not (lo <= pw.pw_uid <= hi):
            continue
        if pw.pw_shell.endswith(("nologin", "/false")) or (shells and pw.pw_shell not in shells):
            continue
        slot = cache / "users" / pw.pw_name
        avatar = ""
        for cand in (slot / "face", Path("/var/lib/AccountsService/icons") / pw.pw_name):
            if os.access(cand, os.R_OK):
                avatar = str(cand)
                break
        out.append({
            "name": pw.pw_name,
            "realName": pw.pw_gecos.split(",")[0].strip() or pw.pw_name,
            "avatar": avatar,
            "synced": (slot / "settings.json").is_file(),
        })
    return sorted(out, key=lambda u: u["name"])


# ── sessions ──

def session_dirs() -> list[tuple[Path, str]]:
    data = [d for d in os.environ.get("XDG_DATA_DIRS", "").split(":") if d]
    data += ["/usr/local/share", "/usr/share"]
    seen, out = set(), []
    for kind, sub in (("wayland", "wayland-sessions"), ("x11", "xsessions")):
        for d in data:
            p = Path(d) / sub
            if p not in seen:
                seen.add(p)
                out.append((p, kind))
    return out


def parse_desktop(path: Path) -> dict:
    entry, section = {}, ""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return {}
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            section = line
            continue
        if section != "[Desktop Entry]" or "=" not in line or line.startswith("#"):
            continue
        k, v = line.split("=", 1)
        entry.setdefault(k.strip(), v.strip())
    return entry


def exec_argv(exec_line: str) -> list[str]:
    # drop desktop-entry field codes (%f, %U…); %% is a literal percent
    cleaned = re.sub(r"%[fFuUdDnNickvm]", "", exec_line).replace("%%", "%")
    try:
        return shlex.split(cleaned)
    except ValueError:
        return cleaned.split()


def list_sessions() -> list[dict]:
    out, seen = [], set()
    startx = shutil.which("startx")
    for d, kind in session_dirs():
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.desktop")):
            sid = f.stem
            if sid in seen:
                continue
            e = parse_desktop(f)
            if not e.get("Name") or not e.get("Exec"):
                continue
            if e.get("Hidden", "").lower() == "true" or e.get("NoDisplay", "").lower() == "true":
                continue
            if (te := e.get("TryExec")) and not (shutil.which(te) or os.access(te, os.X_OK)):
                continue
            argv = exec_argv(e["Exec"])
            if not argv:
                continue
            if kind == "x11":
                if not startx:
                    continue
                argv = [startx, "/usr/bin/env"] + argv
            seen.add(sid)
            desktops = e.get("DesktopNames", "").rstrip(";").replace(";", ":")
            env = [f"XDG_SESSION_TYPE={kind}", f"XDG_SESSION_DESKTOP={sid}"]
            if desktops:
                env.append(f"XDG_CURRENT_DESKTOP={desktops}")
            out.append({
                "id": sid,
                "name": e["Name"] + (" (X11)" if kind == "x11" else ""),
                "comment": e.get("Comment", ""),
                "type": kind,
                "command": argv,
                "env": env,
            })
    return out


# ── sync ──

def user_settings_path() -> Path:
    base = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return base / "flamenco" / "settings.json"


def expand(p: str) -> Path | None:
    if not p:
        return None
    p = p[7:] if p.startswith("file://") else p
    return Path(os.path.expanduser(p))


VIDEO_EXTS = (".mp4", ".webm", ".mkv", ".mov", ".m4v", ".avi")


def is_video(path: Path) -> bool:
    return path.suffix.lower() in VIDEO_EXTS


def is_animated(path: Path) -> bool:
    return is_video(path) or path.suffix.lower() == ".gif"


def video_still(video: Path) -> Path | None:
    """A video's still: the poster Flamenco Shell already made (same name as its
    Paths.poster(): md5 of the path), else one made now with ffmpeg."""
    xdg_cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    poster = xdg_cache / "flamenco" / "live" / (hashlib.md5(str(video).encode()).hexdigest() + ".jpg")
    if poster.is_file() and poster.stat().st_size:
        return poster
    if not shutil.which("ffmpeg"):
        return None
    tmp = Path(tempfile.mkstemp(prefix="flamenco-greeter-still-", suffix=".jpg")[1])
    for seek in (["-ss", "1"], []):
        subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", *seek, "-i", str(video),
                        "-frames:v", "1", "-vf", "scale=min(2560\\,iw):-2", "-q:v", "3", str(tmp)],
                       capture_output=True, timeout=60)
        if tmp.stat().st_size:
            return tmp
    tmp.unlink(missing_ok=True)
    return None


def copy_wallpaper(src: Path, dest: Path, stem: str, notes: list[str]) -> str:
    """Copy a wallpaper into a slot; a video also gets its still next to it, as
    <name>.jpg, which the greeter shows until the video plays (or instead of it)."""
    name = stem + src.suffix.lower()
    shutil.copyfile(src, dest / name)
    if is_video(src):
        still = video_still(src)
        if still:
            shutil.copyfile(still, dest / (name + ".jpg"))
        else:
            notes.append(f"           no still for {src.name} (install ffmpeg); it shows once it plays")
    return name



def stage_user(dest: Path, cache: Path, user: str) -> list[str]:
    """Write a user's greeter slot into `dest`, with paths pointing at `cache`.
    Returns notes about what was (or wasn't) copied."""
    notes = []
    src = read_json(user_settings_path())
    if not src:
        raise SystemExit(die(f"no settings at {user_settings_path()}; start Flamenco Shell once first"))
    slot = cache / "users" / user
    dest.mkdir(parents=True, exist_ok=True)

    synced: dict = {"configVersion": src.get("configVersion", 0)}
    for section, keys in SYNCED_KEYS.items():
        part = src.get(section) or {}
        synced[section] = dict(part) if keys is None else {k: part[k] for k in keys if k in part}

    wall = expand((src.get("wallpaper") or {}).get("current", ""))
    if wall and wall.is_file():
        name = copy_wallpaper(wall, dest, "wallpaper", notes)
        synced["wallpaper"]["current"] = str(slot / name)
        notes.append(f"wallpaper  {wall}" + ("  (live)" if is_animated(wall) else ""))
    else:
        synced["wallpaper"]["current"] = ""
        notes.append("wallpaper  none set")

    # one wallpaper per screen (Wallpaper → per screen in the shell)
    screens = {}
    for i, (output, path) in enumerate(sorted((synced["wallpaper"].get("screens") or {}).items())):
        f = expand(str(path))
        if f and f.is_file():
            screens[output] = str(slot / copy_wallpaper(f, dest, f"screen-{i}", notes))
    synced["wallpaper"]["screens"] = screens
    if synced["wallpaper"].get("perScreen") and screens:
        notes.append(f"per screen {', '.join(screens)}")

    face = expand((src.get("general") or {}).get("avatar", "") or "~/.face")
    if face and face.is_file():
        shutil.copyfile(face, dest / "face")
        synced["general"]["avatar"] = str(slot / "face")
        notes.append(f"avatar     {face}")
    else:
        synced["general"]["avatar"] = ""
        notes.append("avatar     none (set one in Settings → About, or ~/.face)")

    (dest / "settings.json").write_text(json.dumps(synced, indent=2) + "\n")
    notes.append(f"theme      {synced['appearance'].get('palette', 'flamenco')} / {synced['appearance'].get('mode', 'dark')}")
    return notes


def privileged(cmd: list[str]) -> int:
    """Run as root: sudo in a terminal, pkexec otherwise (e.g. from the Settings app)."""
    if os.geteuid() == 0:
        return subprocess.call(cmd)
    if sys.stdin.isatty() and shutil.which("sudo"):
        return subprocess.call(["sudo"] + cmd)
    if shutil.which("pkexec"):
        return subprocess.call(["pkexec"] + cmd)
    return die("need root: install sudo or polkit (pkexec)")


def cmd_sync(args: list[str]) -> int:
    cache = DEFAULT_CACHE
    quiet = "--quiet" in args
    no_sudo = "--no-sudo" in args
    if "--cache-dir" in args:
        cache = Path(args[args.index("--cache-dir") + 1])
    if os.geteuid() == 0:
        return die("run sync as your own user, not root; it asks for sudo when it needs it")
    user = pwd.getpwuid(os.getuid()).pw_name

    with tempfile.TemporaryDirectory(prefix="flamenco-greeter-") as tmp:
        stage = Path(tmp) / user
        notes = stage_user(stage, cache, user)
        dest = cache / "users" / user

        # Members of the greeter group can write directly; everyone else goes through sudo once.
        if os.access(cache, os.W_OK | os.X_OK) and (not dest.exists() or os.access(dest, os.W_OK)):
            if not dest.exists():
                dest.mkdir(parents=True)
                os.chmod(dest, 0o2770)
            for f in stage.iterdir():
                existed = (dest / f.name).exists()
                shutil.copyfile(f, dest / f.name)
                if not existed:  # files the greeter (or sudo) created stay owned by greeter
                    os.chmod(dest / f.name, 0o660)
        elif no_sudo:
            return die(f"can't write to {cache}; add yourself to the {GREETER_USER} group or run sync without --no-sudo")
        else:
            os.chmod(tmp, 0o755)
            for f in stage.iterdir():
                os.chmod(f, 0o644)
            script = (
                f"set -e; [ -d {shlex.quote(str(cache))} ] || install -d -m 2770 -o {GREETER_USER} -g {GREETER_USER} {shlex.quote(str(cache))}; "
                f"[ -d {shlex.quote(str(cache / 'users'))} ] || install -d -m 2770 -o {GREETER_USER} -g {GREETER_USER} {shlex.quote(str(cache / 'users'))}; "
                f"rm -rf {shlex.quote(str(dest))}; cp -r {shlex.quote(str(stage))} {shlex.quote(str(dest))}; "
                f"chown -R {GREETER_USER}:{GREETER_USER} {shlex.quote(str(dest))}; "
                f"chmod 2770 {shlex.quote(str(dest))}; chmod 660 {shlex.quote(str(dest))}/*"
            )
            if not quiet:
                print(f"Copying to {dest} (needs root)…")
            if privileged(["sh", "-c", script]) != 0:
                return die("sync failed")

    if not quiet:
        print(f"Synced {user} to the login screen:")
        for n in notes:
            print("  " + n)
        try:
            in_group = grp.getgrnam(GREETER_USER).gr_gid in os.getgroups()
        except KeyError:
            in_group = False
        if not in_group:
            print(f"\nTip: `sudo usermod -aG {GREETER_USER} {user}` (then log in again) lets sync run without sudo,")
            print("so the login screen can follow theme changes automatically.")
    return 0


# ── launcher ──

def pick_active_theme(cache: Path) -> str:
    """Copy the last user's synced settings to where the shell's Settings reads them."""
    users = cache / "users"
    mem = read_json(cache / "state" / "memory.json")
    candidates = []
    if mem.get("lastUser"):
        candidates.append(users / mem["lastUser"] / "settings.json")
    if users.is_dir():
        candidates += sorted(users.glob("*/settings.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    target = cache / "config" / "flamenco" / "settings.json"
    place_stills(cache)
    for c in candidates:
        if c.is_file():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(c, target)
            return c.parent.name
    return ""


def place_stills(cache: Path) -> None:
    """Put each synced live wallpaper's still where the shell's ColorGen looks for a
    video's colors (Paths.poster: <XDG_CACHE_HOME>/flamenco/live/<md5 of path>.jpg)."""
    live = cache / "cache" / "flamenco" / "live"
    for settings in (cache / "users").glob("*/settings.json") if (cache / "users").is_dir() else []:
        w = read_json(settings).get("wallpaper") or {}
        for path in [w.get("current", "")] + list((w.get("screens") or {}).values()):
            p = Path(path) if path else None
            still = Path(str(p) + ".jpg") if p and is_video(p) else None
            if still and still.is_file():
                try:
                    live.mkdir(parents=True, exist_ok=True)
                    shutil.copyfile(still, live / (hashlib.md5(str(p).encode()).hexdigest() + ".jpg"))
                except OSError:
                    pass


def cursor_theme_dir(theme: str) -> Path | None:
    if not theme:
        return None
    dirs = [d for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if d]
    for d in [Path(d) / "icons" for d in dirs] + [Path("/usr/share/icons")]:
        if (d / theme / "cursors").is_dir():
            return d
    return None


def kdl_str(s: str) -> str:
    return json.dumps(s)


def lua_str(s: str) -> str:
    return json.dumps(s)


def niri_config(base: str, qs_cmd: str, kb: dict, cursor: tuple[str, int] | None, overrides: bool = True) -> str:
    xkb = "".join(f"            {k} {kdl_str(kb[k])}\n" for k in ("layout", "variant", "options", "model") if kb.get(k))
    lines = [base.rstrip(), "", "// flamenco-greeter", "hotkey-overlay {\n    skip-at-startup\n}",
             "prefer-no-csd",
             "environment {\n    FLAMENCO_GREETER \"1\"\n}",
             "gestures {\n    hot-corners {\n        off\n    }\n}",
             "layout {\n    background-color \"#000000\"\n}",
             "input {\n    keyboard {\n" + (f"        xkb {{\n{xkb}        }}\n" if xkb else "")
             + f"        repeat-delay {int(kb.get('repeatDelay', 600))}\n        repeat-rate {int(kb.get('repeatRate', 25))}\n"
             + ("        numlock\n" if kb.get("numlock", True) else "") + "    }\n}"]
    if cursor:
        lines.append(f"cursor {{\n    xcursor-theme {kdl_str(cursor[0])}\n    xcursor-size {cursor[1]}\n}}")
    for override in NIRI_OVERRIDES if overrides else ():
        if Path(override).exists():
            lines.append(f"include {kdl_str(override)}")
    lines.append(f"spawn-at-startup \"sh\" \"-c\" {kdl_str(qs_cmd + '; niri msg action quit --skip-confirmation')}")
    return "\n".join(lines) + "\n"


def hypr_lua_config(base: str, qs_cmd: str, kb: dict) -> str:
    inp = {"kb_layout": kb.get("layout", ""), "kb_variant": kb.get("variant", ""),
           "kb_options": kb.get("options", ""), "kb_model": kb.get("model", "")}
    inp_lua = "".join(f"        {k} = {lua_str(v)},\n" for k, v in inp.items() if v)
    inp_lua += f"        repeat_delay = {int(kb.get('repeatDelay', 600))},\n        repeat_rate = {int(kb.get('repeatRate', 25))},\n"
    inp_lua += f"        numlock_by_default = {'true' if kb.get('numlock', True) else 'false'},\n"
    run = f"sh -c \"{qs_cmd}; hyprctl dispatch 'hl.dsp.exit()'\""
    return f"""{base.rstrip()}

-- flamenco-greeter
hl.env("FLAMENCO_GREETER", "1")
hl.config({{
    misc = {{
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
    }},
    input = {{
{inp_lua}    }},
}})
hl.on("hyprland.start", function()
    hl.exec_cmd({lua_str(run)})
end)
"""


def hypr_conf_config(base: str, qs_cmd: str, kb: dict) -> str:
    lines = [base.rstrip(), "", "# flamenco-greeter", "env = FLAMENCO_GREETER,1",
             "misc {\n    disable_hyprland_logo = true\n    disable_splash_rendering = true\n}", "input {"]
    for key, field in (("kb_layout", "layout"), ("kb_variant", "variant"), ("kb_options", "options"), ("kb_model", "model")):
        if kb.get(field):
            lines.append(f"    {key} = {kb[field]}")
    lines += [f"    numlock_by_default = {'true' if kb.get('numlock', True) else 'false'}", "}",
              f"exec-once = sh -c {shlex.quote(qs_cmd + '; hyprctl dispatch exit')}"]
    return "\n".join(lines) + "\n"


def sway_config(base: str, qs_cmd: str, kb: dict) -> str:
    lines = [base.rstrip(), "", "# flamenco-greeter"]
    for key, field in (("xkb_layout", "layout"), ("xkb_variant", "variant"), ("xkb_options", "options"), ("xkb_model", "model")):
        if kb.get(field):
            lines.append(f"input type:keyboard {key} {shlex.quote(kb[field])}")
    if kb.get("numlock", True):
        lines.append("input type:keyboard xkb_numlock enabled")
    lines.append(f"exec {shlex.quote(qs_cmd + '; swaymsg exit')}")
    return "\n".join(lines) + "\n"


def cmd_launch(args: list[str]) -> int:
    compositor, base_cfg, path, cache, debug = "", "", None, DEFAULT_CACHE, False
    i = 0
    while i < len(args):
        a = args[i]
        val = args[i + 1] if i + 1 < len(args) else ""
        if a == "--command":
            compositor, i = val, i + 2
        elif a in ("-C", "--config"):
            base_cfg, i = val, i + 2
        elif a in ("-p", "--path"):
            path, i = Path(val), i + 2
        elif a == "--cache-dir":
            cache, i = Path(val), i + 2
        elif a == "--no-save-session":
            os.environ["FLAMENCO_GREETER_REMEMBER_SESSION"] = "0"
            i += 1
        elif a == "--no-save-username":
            os.environ["FLAMENCO_GREETER_REMEMBER_USER"] = "0"
            i += 1
        elif a == "--debug":
            debug, i = True, i + 1
        else:
            print(__doc__)
            return die(f"unknown option {a}")

    compositor = {"Hyprland": "hyprland", "start-hyprland": "hyprland"}.get(compositor, compositor)
    if compositor not in COMPOSITORS:
        return die(f"--command must be one of: {', '.join(COMPOSITORS)}")
    # Anything that would stop the UI from coming up falls back to a text
    # login with the reason on screen; exiting instead would have greetd
    # restart us straight away: a black screen that keeps retrying.
    qml = path or greeter_dir()
    if not cache.is_dir():
        return text_login(f"{cache} doesn't exist (reinstall, or run `systemd-tmpfiles --create`)", cache)
    for sub in ("config", "state", "cache", "data"):
        (cache / sub).mkdir(parents=True, exist_ok=True)
    if not (qml / "shell.qml").exists():
        return text_login(f"its interface is missing ({qml})", cache)
    qs = qs_bin()
    if not qs:
        return text_login("Quickshell (qs) is not installed", cache)
    compositor_bin = {"niri": "niri", "hyprland": "Hyprland", "sway": "sway"}[compositor]
    if not shutil.which(compositor_bin) and not (compositor == "hyprland" and shutil.which("start-hyprland")):
        return text_login(f"{compositor_bin} is not installed", cache)

    crashes = recent_crashes(cache)
    if len(crashes) >= CRASH_LIMIT:
        clear_crashes(cache)     # the next start gets a fresh try
        return text_login(f"the login screen crashed {len(crashes)} times in a row", cache)
    ok, why = ui_loads(qml, cache)
    if not ok:
        return text_login(f"its interface doesn't load: {why}", cache)

    pick_active_theme(cache)
    settings = read_json(cache / "config" / "flamenco" / "settings.json")
    kb = settings.get("keyboard") or {}
    apps = settings.get("apps") or {}

    env = os.environ
    env.update({
        "XDG_SESSION_TYPE": "wayland",
        "QT_QPA_PLATFORM": "wayland",
        "QT_WAYLAND_DISABLE_WINDOWDECORATION": "1",
        "FLAMENCO_GREETER": "1",
        "FLAMENCO_GREETER_CACHE": str(cache),
        "FLAMENCO_GREETER_BIN": str(SELF),
        "HOME": str(cache),
        "XDG_CONFIG_HOME": str(cache / "config"),
        "XDG_STATE_HOME": str(cache / "state"),
        "XDG_CACHE_HOME": str(cache / "cache"),
        "XDG_DATA_HOME": str(cache / "data"),
    })
    # on the bare GPU, as greetd runs it; not when nested in a desktop for testing
    if not os.environ.get("WAYLAND_DISPLAY"):
        env["EGL_PLATFORM"] = "gbm"
    env.setdefault("RUST_LOG", "warn")
    env.setdefault("NIRI_LOG", "warn")
    # systems without logind/pam_rundir (e.g. seatd) leave this unset, and compositors refuse to start
    if not env.get("XDG_RUNTIME_DIR") or not Path(env["XDG_RUNTIME_DIR"]).is_dir():
        run = cache / "run"
        run.mkdir(mode=0o700, exist_ok=True)
        env["XDG_RUNTIME_DIR"] = str(run)

    cursor = None
    if (cdir := cursor_theme_dir(apps.get("cursorTheme", ""))):
        cursor = (apps["cursorTheme"], int(apps.get("cursorSize") or 24))
        env["XCURSOR_PATH"] = str(cdir) + (":" + env["XCURSOR_PATH"] if env.get("XCURSOR_PATH") else "")
        env["XCURSOR_THEME"], env["XCURSOR_SIZE"] = cursor[0], str(cursor[1])

    qs_cmd = "sh " + shlex.quote(str(write_runner(cache, qs, qml)))
    try:
        base = Path(base_cfg).read_text() if base_cfg else ""
    except OSError as e:
        print(f"flamenco-greeter: ignoring -C {base_cfg}: {e}", file=sys.stderr)
        base = ""
    gen = cache / "state"
    if compositor == "niri":
        cfg = gen / "niri.kdl"
        cfg.write_text(niri_config(base, qs_cmd, kb, cursor))
        problem = niri_invalid(cfg)
        if problem:
            # usually a mistake in -C or /etc/greetd/flamenco-niri.kdl: start without them
            print(f"flamenco-greeter: niri config invalid ({problem}); retrying without -C and overrides", file=sys.stderr)
            cfg.write_text(niri_config("", qs_cmd, kb, cursor, overrides=False))
            problem = niri_invalid(cfg)
            if problem:
                return text_login(f"its niri config is invalid: {problem}", cache)
        argv = ["niri", "-c", str(cfg)]
    elif compositor == "hyprland":
        lua = not base_cfg or base_cfg.endswith(".lua")
        cfg = gen / ("hyprland.lua" if lua else "hyprland.conf")
        cfg.write_text(hypr_lua_config(base, qs_cmd, kb) if lua else hypr_conf_config(base, qs_cmd, kb))
        argv = (["start-hyprland", "--", "--config", str(cfg)] if shutil.which("start-hyprland")
                else ["Hyprland", "-c", str(cfg)])
    else:
        cfg = gen / "sway.conf"
        cfg.write_text(sway_config(base, qs_cmd, kb))
        argv = ["sway", "--unsupported-gpu", "-c", str(cfg)]

    if not debug:
        # hide leftover console text behind the greeter, then hand logs to the journal
        try:
            with open("/dev/tty", "w") as tty:
                tty.write("\033[2J\033[H\033[3J\033[?25l")
        except OSError:
            pass
        if shutil.which("systemd-cat"):
            argv = ["systemd-cat", "-t", f"flamenco-greeter/{compositor}", "--"] + argv
        else:
            log = os.open(cache / f"{compositor}.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o640)
            os.dup2(log, 1)
            os.dup2(log, 2)
    os.execvpe(argv[0], argv, env)


# ── fingerprint ──
#
# The greeter never asks fprintd about other users itself (that needs the
# polkit `setusername` right, which would also let it enroll fingers for
# anyone). pam_fprintd does the checking as root: the greeter opens a PAM
# session as soon as a user is picked, and pam_fprintd starts the reader if
# that user has prints enrolled, or falls through to the password if not.

def pam_module_path(name: str) -> Path | None:
    for d in ("/usr/lib/security", "/lib/security", "/usr/lib64/security", "/lib64/security",
              "/usr/lib/x86_64-linux-gnu/security", "/usr/lib/aarch64-linux-gnu/security"):
        if (Path(d) / name).exists():
            return Path(d) / name
    return None


def pam_lines(path: Path) -> list[str]:
    try:
        return path.read_text().splitlines()
    except OSError:
        return []


def pam_has_module(path: Path, module: str, depth: int = 0) -> bool:
    """Whether `module` takes part in auth for this PAM file, following includes."""
    for raw in pam_lines(path):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if parts[0].lstrip("-") != "auth" and not parts[0].startswith("@include"):
            continue
        if module in line:
            return True
        target = None
        if parts[0].startswith("@include") and len(parts) > 1:
            target = parts[1]
        elif len(parts) > 2 and parts[1] in ("include", "substack"):
            target = parts[2]
        if target and depth < 5 and pam_has_module(path.parent / target, module, depth + 1):
            return True
    return False


def pam_managed(path: Path = GREETD_PAM) -> bool:
    return PAM_BEGIN in "\n".join(pam_lines(path))


def pam_outdated(path: Path = GREETD_PAM) -> bool:
    """A managed block written by an older version, with different pam_fprintd options."""
    return pam_managed(path) and PAM_FPRINT not in pam_lines(path)


def fprint_readers() -> int | None:
    """Number of fingerprint readers fprintd sees; None when fprintd isn't there."""
    if not shutil.which("gdbus"):
        return None
    try:
        out = subprocess.run(["gdbus", "call", "--system", "--dest", FPRINT_BUS,
                              "--object-path", "/net/reactivated/Fprint/Manager",
                              "--method", "net.reactivated.Fprint.Manager.GetDevices"],
                             capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return len(re.findall(r"objectpath '[^']+'", out.stdout))


def fprint_enrolled(user: str) -> bool | None:
    """Whether `user` has prints enrolled (works for yourself, or as root)."""
    if not shutil.which("fprintd-list"):
        return None
    try:
        out = subprocess.run(["fprintd-list", user], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return bool(re.search(r"^\s*-\s*#\d+:", out.stdout, re.M))


def fingerprint_state() -> dict:
    readers = fprint_readers()
    return {
        "module": pam_module_path("pam_fprintd.so") is not None,
        "pam": pam_has_module(GREETD_PAM, "pam_fprintd"),
        "managed": pam_managed(),
        "outdated": pam_outdated(),
        "readers": readers or 0,
        "fprintd": readers is not None,
    }


def pam_with_fingerprint(text: str) -> str:
    """Insert the managed pam_fprintd block ahead of the password stack."""
    lines = text.splitlines()
    block = [PAM_BEGIN, PAM_FPRINT, PAM_END]
    auth = [i for i, l in enumerate(lines) if l.split("#", 1)[0].split()[:1] in (["auth"], ["-auth"])]
    stack = [i for i in auth if len(lines[i].split()) > 2 and lines[i].split()[1] in ("include", "substack")]
    at = stack[0] if stack else auth[0] if auth else len(lines)
    return "\n".join(lines[:at] + block + lines[at:]) + "\n"


def pam_without_fingerprint(text: str) -> str:
    out, skip = [], False
    for l in text.splitlines():
        if l.strip() == PAM_BEGIN:
            skip = True
        elif l.strip() == PAM_END:
            skip = False
        elif not skip:
            out.append(l)
    return "\n".join(out) + "\n"


def write_pam(text: str) -> int:
    stamp = time.strftime("%Y%m%d-%H%M%S")
    with tempfile.NamedTemporaryFile("w", prefix="flamenco-greeter-pam-", delete=False) as f:
        f.write(text)
        tmp = f.name
    os.chmod(tmp, 0o644)
    script = (f"set -e; cp {GREETD_PAM} {GREETD_PAM}.bak-{stamp}; "
              f"install -m 644 -o root -g root {shlex.quote(tmp)} {GREETD_PAM}")
    try:
        return privileged(["sh", "-c", script])
    finally:
        os.unlink(tmp)


def cmd_fingerprint(args: list[str]) -> int:
    action = args[0] if args else "status"
    if action == "--json":
        print(json.dumps(fingerprint_state()))
        return 0
    st = fingerprint_state()
    if action == "status":
        user = pwd.getpwuid(os.getuid()).pw_name
        enrolled = fprint_enrolled(user)
        rows = [
            ("fprintd running", st["fprintd"], "install fprintd"),
            (f"reader found ({st['readers']})", st["readers"] > 0, "plug in or enable the reader"),
            ("pam_fprintd installed", st["module"], "install fprintd"),
            (f"fingerprint login in {GREETD_PAM}", st["pam"], "flamenco-greeter fingerprint enable"),
            ("fingerprint settings up to date", not st["outdated"], "flamenco-greeter fingerprint enable"),
            (f"fingers enrolled for {user}", bool(enrolled), "fprintd-enroll"),
        ]
        for name, ok, hint in rows:
            mark = "\033[32m✓\033[0m" if ok else "\033[31m✗\033[0m"
            print(f" {mark} {name}" + ("" if ok else f"  →  {hint}"))
        if st["pam"] and not st["managed"]:
            print(f"\n pam_fprintd comes from your own PAM setup (not managed by flamenco-greeter).")
        return 0 if all(r[1] for r in rows) else 1
    if action == "enable":
        if not GREETD_PAM.exists():
            return die(f"{GREETD_PAM} not found; install greetd first")
        if not st["module"]:
            return die("pam_fprintd.so not found; install fprintd")
        if st["outdated"]:
            text = pam_with_fingerprint(pam_without_fingerprint(GREETD_PAM.read_text()))
            if write_pam(text) != 0:
                return die(f"could not update {GREETD_PAM}")
            print(f"Fingerprint login updated in {GREETD_PAM} (backup next to it).")
            return 0
        if st["pam"]:
            print("Fingerprint login is already enabled" + ("." if st["managed"] else " by your own PAM setup; leaving it alone."))
            if not st["managed"]:
                print("Tip: short pam_fprintd rounds (max-tries=1 timeout=10) keep typed passwords quick.")
            return 0
        if write_pam(pam_with_fingerprint(GREETD_PAM.read_text())) != 0:
            return die(f"could not update {GREETD_PAM}")
        print(f"Fingerprint login enabled in {GREETD_PAM} (backup next to it).")
        if st["readers"] == 0:
            print("Note: fprintd doesn't see a reader right now.")
        print("Enroll a finger with `fprintd-enroll` if you haven't yet.")
        return 0
    if action == "disable":
        if not st["managed"]:
            if st["pam"]:
                return die(f"pam_fprintd in {GREETD_PAM} wasn't added by flamenco-greeter; edit it by hand")
            print("Fingerprint login isn't enabled.")
            return 0
        if write_pam(pam_without_fingerprint(GREETD_PAM.read_text())) != 0:
            return die(f"could not update {GREETD_PAM}")
        print("Fingerprint login disabled.")
        return 0
    return die("usage: flamenco-greeter fingerprint status|enable|disable|--json")


# ── health ──
#
# A broken greeter (most often: Flamenco Shell updated in a way this version
# doesn't expect) makes Quickshell exit at once; niri then quits and greetd
# starts it all again — a black screen that keeps retrying. So the launcher
# test-loads the UI off-screen before starting the compositor, counts crashes,
# and falls back to greetd's text login (agreety) with the reason on screen.

SHARED_LINKS = ("Commons", "Widgets", "assets", "Services/Time.qml", "Services/Weather.qml")
CRASH_LIMIT, CRASH_WINDOW = 3, 300      # this many crashes within this many seconds → text login


def strip_ansi(text: str) -> str:
    return re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text)


def run_out(cmd: list[str], timeout: int = 10) -> tuple[int, str, str]:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return -1, "", str(e)


def qml_check(qml: Path, timeout: int = 25) -> tuple[bool, list[str]]:
    """Load the greeter UI off-screen (no display needed) and report QML errors."""
    qs = qs_bin()
    if not qs:
        return False, ["Quickshell (qs) is not installed"]
    with tempfile.TemporaryDirectory(prefix="flamenco-greeter-check-") as tmp:
        env = {k: v for k, v in os.environ.items() if k not in ("WAYLAND_DISPLAY", "DISPLAY", "QT_QPA_PLATFORM")}
        env.update({
            "HOME": tmp, "XDG_CONFIG_HOME": f"{tmp}/config", "XDG_STATE_HOME": f"{tmp}/state",
            "XDG_CACHE_HOME": f"{tmp}/cache", "XDG_DATA_HOME": f"{tmp}/data",
            "QT_QPA_PLATFORM": "offscreen", "FLAMENCO_GREETER_CHECK": "1", "FLAMENCO_GREETER_WINDOWED": "1",
            "FLAMENCO_GREETER_CACHE": tmp, "FLAMENCO_GREETER_BIN": str(SELF),
        })
        if not env.get("XDG_RUNTIME_DIR") or not os.access(env["XDG_RUNTIME_DIR"], os.W_OK):
            env["XDG_RUNTIME_DIR"] = tmp
        try:
            r = subprocess.run([qs, "-p", str(qml)], env=env, capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            return False, [f"it didn't finish loading within {timeout} s"]
        except OSError as e:
            return False, [str(e)]
    text = strip_ansi(r.stdout + r.stderr)
    if r.returncode == 0 and "flamenco-greeter-check: loaded" in text:
        return True, []
    errors = [l.split("ERROR:", 1)[1].strip() for l in text.splitlines() if "ERROR:" in l]
    errors = [e for e in errors if e] or [l.strip() for l in text.splitlines() if l.strip()][-5:]
    return False, errors[:8] or [f"qs exited with {r.returncode}"]


def ui_key(qml: Path) -> str:
    """Changes whenever the greeter, the linked Flamenco Shell files or Quickshell change."""
    h = hashlib.sha1(run_out([qs_bin() or "qs", "--version"])[1].encode())
    for dirpath, dirs, files in os.walk(qml, followlinks=True):
        dirs.sort()
        for f in sorted(files):
            if f.endswith((".qml", ".js")):
                try:
                    st = (Path(dirpath) / f).stat()
                    h.update(f"{dirpath}/{f}:{st.st_mtime_ns}:{st.st_size}".encode())
                except OSError:
                    pass
    return h.hexdigest()


def ui_loads(qml: Path, cache: Path) -> tuple[bool, str]:
    """qml_check, remembered while nothing changes (only successes are kept)."""
    key = ui_key(qml)
    memo = cache / "state" / "ui-check.json"
    if read_json(memo).get("key") == key:
        return True, ""
    ok, errors = qml_check(qml)
    if ok:
        try:
            memo.write_text(json.dumps({"key": key, "time": int(time.time())}))
        except OSError:
            pass
        return True, ""
    why = errors[-1] if errors else "unknown error"
    return False, why if len(why) <= 160 else why[:157] + "…"


def crash_times(cache: Path) -> list[int]:
    try:
        return [int(l) for l in (cache / "state" / "failures").read_text().split() if l.isdigit()]
    except OSError:
        return []


def recent_crashes(cache: Path, window: int = CRASH_WINDOW) -> list[int]:
    now = time.time()
    return [t for t in crash_times(cache) if now - t < window]


def clear_crashes(cache: Path) -> None:
    try:
        (cache / "state" / "failures").unlink()
    except OSError:
        pass


def write_runner(cache: Path, qs: str, qml: Path) -> Path:
    """The script the compositor runs: the UI, plus a note of each crash.
    (A script rather than inline shell keeps `$` out of niri/Hyprland/sway configs.)"""
    fails = shlex.quote(str(cache / "state" / "failures"))
    runner = cache / "state" / "run-greeter.sh"
    runner.write_text(f"""#!/bin/sh
# Written by flamenco-greeter at every start. Runs the login screen and notes
# crashes, so the launcher can offer a text login instead of a black screen.
{shlex.quote(qs)} -p {shlex.quote(str(qml))}
code=$?
# 0: a session was started; 143: stopped for shutdown
if [ "$code" -ne 0 ] && [ "$code" -ne 143 ]; then date +%s >> {fails}; else rm -f {fails}; fi
exit "$code"
""")
    runner.chmod(0o755)
    return runner


def niri_invalid(cfg: Path) -> str:
    """'' when niri accepts the config, else its complaint."""
    code, out, err = run_out(["niri", "validate", "-c", str(cfg)])
    if code == 0:
        return ""
    lines = [l.strip() for l in strip_ansi(out + "\n" + err).splitlines()
             if l.strip() and " INFO " not in l and " DEBUG " not in l]
    return lines[-1] if lines else f"niri validate exited with {code}"


def fallback_command(cache: Path) -> str:
    """What the text login starts: the remembered session, else the first one, else a shell."""
    sessions = list_sessions()
    last = read_json(cache / "state" / "memory.json").get("lastSession", "")
    s = next((x for x in sessions if x["id"] == last), sessions[0] if sessions else None)
    return " ".join(shlex.quote(a) for a in s["command"]) if s else "/bin/sh -l"


def text_login(reason: str, cache: Path) -> int:
    """Fall back to greetd's text greeter, saying why, instead of looping on a black screen."""
    print(f"flamenco-greeter: falling back to a text login: {reason}", file=sys.stderr)
    try:
        with open(cache / "state" / "fallback", "a") as f:
            f.write(f"{int(time.time())} {reason}\n")
    except OSError:
        pass
    try:
        with open("/dev/tty", "w") as tty:
            tty.write("\033[2J\033[H\033[?25h\n"
                      f"  Flamenco Greeter couldn't start: {reason}\n\n"
                      "  Log in below. Afterwards, run `flamenco-greeter doctor` to see what's wrong.\n\n")
    except OSError:
        pass
    agreety = shutil.which("agreety")
    if not agreety:
        time.sleep(30)   # nothing better to offer; at least don't spin
        return 1
    os.execvp(agreety, [agreety, "--cmd", fallback_command(cache)])
    return 1


# ── widgets ──

def write_greeter_file(path: Path, text: str) -> int:
    """Write a file in the greeter's data folder (directly if we may, else through sudo)."""
    if os.access(path.parent, os.W_OK) and (not path.exists() or os.access(path, os.W_OK)):
        path.write_text(text)
        return 0
    with tempfile.NamedTemporaryFile("w", prefix="flamenco-greeter-", delete=False) as f:
        f.write(text)
        tmp = f.name
    os.chmod(tmp, 0o644)
    try:
        return privileged(["install", "-m", "660", "-o", GREETER_USER, "-g", GREETER_USER, tmp, str(path)])
    finally:
        os.unlink(tmp)


def cmd_widgets(args: list[str]) -> int:
    action = args[0] if args else "list"
    path = DEFAULT_CACHE / "state" / "widgets.json"
    if not can_read(path.parent):
        return die(f"can't read {path.parent}: join the {GREETER_USER} group, or use sudo")
    data = read_json(path)
    data.setdefault("widgets", [])
    data.setdefault("locked", False)
    if action == "list":
        if not data["widgets"]:
            print("No widgets yet. Press and hold the login screen's background to add some.")
        for w in data["widgets"]:
            extra = w.get("config", {}).get("city") or w.get("config", {}).get("text", "")[:40]
            print(f"  {w['type']:<9} at {w['x']:.2f}, {w['y']:.2f}" + (f"  ({extra})" if extra else ""))
        print("Editing is locked." if data["locked"] else "Editing: press and hold the background.")
        return 0
    if action in ("lock", "unlock"):
        data["locked"] = action == "lock"
    elif action == "reset":
        data["widgets"] = []
    else:
        return die("usage: flamenco-greeter widgets list|lock|unlock|reset")
    if write_greeter_file(path, json.dumps(data, indent=2)) != 0:
        return die(f"couldn't write {path}")
    print({"lock": "Widget editing locked: holding the login screen does nothing now.",
           "unlock": "Widget editing unlocked: press and hold the login screen's background to edit.",
           "reset": "All login-screen widgets removed."}[action])
    print("Takes effect at the next login screen.")
    return 0


# ── enable / preview / doctor ──

def cmd_enable(args: list[str]) -> int:
    compositor = args[0] if args else "niri"
    if compositor not in COMPOSITORS:
        return die(f"compositor must be one of: {', '.join(COMPOSITORS)}")
    exe = "/usr/bin/flamenco-greeter" if Path("/usr/bin/flamenco-greeter").exists() else str(SELF)
    config = (
        "# written by flamenco-greeter enable\n"
        "[terminal]\nvt = 1\n\n"
        "[default_session]\n"
        f"user = \"{GREETER_USER}\"\n"
        f"command = \"{exe} --command {compositor}\"\n"
    )
    print(f"This writes {GREETD_CONFIG}:\n")
    print("    " + config.replace("\n", "\n    "))
    print("and makes greetd the display manager (systemctl enable -f greetd).")
    if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
        return 1
    stamp = time.strftime("%Y%m%d-%H%M%S")
    script = (
        f"set -e; mkdir -p {GREETD_CONFIG.parent}; "
        f"[ -f {GREETD_CONFIG} ] && cp {GREETD_CONFIG} {GREETD_CONFIG}.bak-{stamp} || true; "
        f"printf %s {shlex.quote(config)} > {GREETD_CONFIG}; "
        f"install -d -m 2770 -o {GREETER_USER} -g {GREETER_USER} {DEFAULT_CACHE}; "
        "systemctl enable -f greetd.service"
    )
    if privileged(["sh", "-c", script]) != 0:
        return die("could not enable greetd")
    st = fingerprint_state()
    if st["readers"] and st["module"] and not st["pam"]:
        if input("\nA fingerprint reader is available. Log in with it too? [y/N] ").strip().lower() in ("y", "yes"):
            cmd_fingerprint(["enable"])
    print("\nDone. Run `flamenco-greeter sync` to bring your theme over, then reboot.")
    return 0


def cmd_preview(args: list[str]) -> int:
    fingerprint = "--fingerprint" in args
    as_applied = "--as-applied" in args
    overrides, rest, i = {}, [], 0
    while i < len(args):
        a = args[i]
        if a in ("--palette", "--mode", "--wallpaper", "--widgets", "--from") and i + 1 < len(args):
            overrides[a[2:]] = args[i + 1]
            i += 2
        else:
            if a not in ("--fingerprint", "--as-applied"):
                rest.append(a)
            i += 1
    args = rest
    qs = qs_bin()
    if not qs:
        return die("Quickshell (qs) is not installed")
    user = pwd.getpwuid(os.getuid()).pw_name
    with tempfile.TemporaryDirectory(prefix="flamenco-greeter-preview-") as tmp:
        cache = Path(tmp)
        slot = cache / "users" / user
        stage_user(slot, cache, user)
        if as_applied:
            shutil.rmtree(slot)   # no synced theme: the login screen as Apply alone leaves it
        elif overrides:
            # only the throwaway preview copy changes; your settings stay as they are
            data = read_json(slot / "settings.json")
            app = data.setdefault("appearance", {})
            if "palette" in overrides:
                app["palette"] = overrides["palette"]
                app["accentOverride"] = ""
            if "mode" in overrides:
                app["mode"] = overrides["mode"]
            if "wallpaper" in overrides:
                wall = Path(os.path.expanduser(overrides["wallpaper"]))
                if not wall.is_file():
                    return die(f"no such wallpaper: {wall}")
                name = copy_wallpaper(wall, slot, "preview-wallpaper", [])
                data.setdefault("wallpaper", {})["current"] = str(slot / name)
            (slot / "settings.json").write_text(json.dumps(data, indent=2))
        (cache / "state").mkdir()
        (cache / "state" / "memory.json").write_text(json.dumps({"lastUser": user}))
        # Flamenco Shell's applied Lock & Login settings, with their files (copies: edits stay here)
        source = Path(overrides["from"]) if "from" in overrides else DEFAULT_CACHE
        if "from" in overrides and not can_read(source):
            return die(f"can't read {source}")
        if can_read(source) and (source / "config.json").is_file():
            shutil.copyfile(source / "config.json", cache / "config.json")
            for f in source.glob("wallpaper*"):
                if f.is_file():
                    shutil.copyfile(f, cache / f.name)
            if can_read(source / "avatars"):
                shutil.copytree(source / "avatars", cache / "avatars", dirs_exist_ok=True)
        # widgets: the given layout, else a copy of the login screen's
        layout = Path(overrides["widgets"]) if "widgets" in overrides else source / "state" / "widgets.json"
        if can_read(layout) and layout.is_file():
            shutil.copyfile(layout, cache / "state" / "widgets.json")
        elif "widgets" in overrides:
            return die(f"can't read {layout}")
        pick_active_theme(cache)
        env = dict(os.environ,
                   FLAMENCO_GREETER="1", FLAMENCO_GREETER_PREVIEW="1",
                   FLAMENCO_GREETER_PREVIEW_FINGERPRINT="1" if fingerprint else "0",
                   FLAMENCO_GREETER_CACHE=str(cache), FLAMENCO_GREETER_BIN=str(SELF),
                   HOME=str(cache), XDG_CONFIG_HOME=str(cache / "config"),
                   XDG_STATE_HOME=str(cache / "state"), XDG_CACHE_HOME=str(cache / "cache"))
        return subprocess.call([qs, "-p", str(greeter_dir())] + args, env=env)


# ── doctor ──
#
# Everything the login screen needs, from packages to greetd's service state,
# in the spirit of `flutter doctor`: grouped checks, each ✓ ✗ ! or ·, with the
# next step under anything that's wrong. Meant to be run from a TTY when the
# login screen is black: `sudo flamenco-greeter doctor` also reads the logs
# and the greeter's data folder.

class Report:
    MARKS = {"ok": "✓", "err": "✗", "warn": "!", "info": "·"}
    COLORS = {"ok": "32", "err": "31", "warn": "33", "info": "2"}
    RANK = {"ok": 0, "info": 0, "warn": 1, "err": 2}

    def __init__(self):
        self.sections: list[dict] = []

    def section(self, title: str):
        self.sections.append({"title": title, "items": []})

    def add(self, level: str, text: str, hint: str = "", details: list[str] | None = None):
        self.sections[-1]["items"].append({"level": level, "text": text, "hint": hint, "details": details or []})

    def ok(self, text, hint=""): self.add("ok", text, hint)
    def info(self, text, hint=""): self.add("info", text, hint)
    def warn(self, text, hint="", details=None): self.add("warn", text, hint, details)
    def err(self, text, hint="", details=None): self.add("err", text, hint, details)

    def count(self, level: str) -> int:
        return sum(1 for s in self.sections for i in s["items"] if i["level"] == level)

    def print(self, color: bool):
        def c(code, text):
            return f"\033[{code}m{text}\033[0m" if color else text
        for sec in self.sections:
            worst = max((i["level"] for i in sec["items"]), key=lambda l: self.RANK[l], default="ok")
            worst = "ok" if worst == "info" else worst
            print(f"\n{c(self.COLORS[worst], '[' + self.MARKS[worst] + ']')} {c('1', sec['title'])}")
            for i in sec["items"]:
                print(f"    {c(self.COLORS[i['level']], self.MARKS[i['level']])} {i['text']}")
                for d in i["details"]:
                    print(f"        {c('2', d)}")
                if i["hint"] and i["level"] in ("err", "warn"):
                    print(f"      {c('36', '→')} {i['hint']}")


def pkg_version(pkg: str) -> str:
    if shutil.which("pacman"):
        code, out, _ = run_out(["pacman", "-Q", pkg])
        if code == 0 and out:
            return out.split()[-1]
    return ""


def tool_version(cmd: list[str]) -> str:
    code, out, err = run_out(cmd)
    m = re.search(r"\d+\.\d+(\.\d+)?", out or err)
    return m.group(0) if code == 0 and m else ""


def parse_greetd_config(text: str) -> dict:
    try:
        import tomllib
        return tomllib.loads(text)
    except ImportError:   # Python < 3.11: good enough for greetd's flat config
        data, section = {}, {}
        for line in text.splitlines():
            line = line.split("#", 1)[0].strip()
            if m := re.match(r"\[(\w+)\]$", line):
                section = data.setdefault(m.group(1), {})
            elif "=" in line:
                k, v = (x.strip() for x in line.split("=", 1))
                section[k] = v.strip('"') if v.startswith('"') else int(v) if v.isdigit() else v
        return data


def launcher_options(command: str) -> dict:
    """The flags a greetd `command = "flamenco-greeter …"` line passes."""
    try:
        argv = shlex.split(command)
    except ValueError:
        argv = command.split()
    opts = {"argv": argv, "compositor": "", "config": "", "path": "", "cache": ""}
    names = {"--command": "compositor", "-C": "config", "--config": "config",
             "-p": "path", "--path": "path", "--cache-dir": "cache"}
    for i, a in enumerate(argv):
        if a in names and i + 1 < len(argv):
            opts[names[a]] = argv[i + 1]
    return opts


def journal_lines(args: list[str]) -> list[str] | None:
    """journalctl output, or None when we may not read the system journal."""
    if not shutil.which("journalctl"):
        return None
    code, out, err = run_out(["journalctl", "--no-pager", "-o", "cat"] + args, timeout=15)
    if "insufficient permissions" in err or "not seeing messages" in err or code not in (0, 1):
        return None
    return [l for l in strip_ansi(out).splitlines() if l.strip() and l.strip() != "-- No entries --"]


def systemctl(*args: str) -> str:
    return run_out(["systemctl", *args])[1] if shutil.which("systemctl") else ""


def doctor_user() -> str:
    """Who's asking: under sudo, the person who ran sudo."""
    return os.environ.get("SUDO_USER") or pwd.getpwuid(os.getuid()).pw_name


def can_read(path: Path) -> bool:
    try:
        return os.access(path, os.R_OK) and (not path.is_dir() or os.access(path, os.X_OK))
    except OSError:
        return False


def check_dependencies(r: Report, conf: dict):
    r.section("Dependencies")
    v = pkg_version("greetd")
    if shutil.which("greetd") or Path("/usr/bin/greetd").exists():
        r.ok("greetd" + (f" {v}" if v else ""))
    else:
        r.err("greetd is not installed", "sudo pacman -S greetd")
    if shutil.which("agreety"):
        r.ok("agreety (greetd's text login, the fallback when the greeter can't start)")
    else:
        r.warn("agreety not found: if the greeter breaks there's no text login to fall back to",
               "it ships with greetd; reinstall greetd")

    qs = qs_bin()
    if qs:
        r.ok(f"Quickshell {tool_version([qs, '--version']) or pkg_version('quickshell')}".rstrip())
        roots = [Path(p) for p in os.environ.get("QML_IMPORT_PATH", "").split(":") if p]
        roots += [Path(p) for p in ("/usr/lib/qt6/qml", "/usr/lib64/qt6/qml", "/usr/lib/x86_64-linux-gnu/qt6/qml",
                                    "/usr/lib/aarch64-linux-gnu/qt6/qml", "/run/current-system/sw/lib/qt-6/qml")]
        found = [p for p in roots if (p / "Quickshell" / "Services" / "Greetd").is_dir()]
        if found:
            r.ok("Quickshell has greetd support")
        elif any((p / "Quickshell").is_dir() for p in roots):
            r.err("this Quickshell build has no greetd support (Quickshell.Services.Greetd)",
                  "install a Quickshell built with greetd support (Arch's quickshell package has it)")
        else:
            r.info("couldn't find Quickshell's QML modules to confirm greetd support")
    else:
        r.err("Quickshell (qs) is not installed", "sudo pacman -S quickshell")

    comp = conf.get("compositor") or "niri"
    binary = {"niri": "niri", "hyprland": "Hyprland", "sway": "sway"}.get(comp, comp)
    if shutil.which(binary) or (comp == "hyprland" and shutil.which("start-hyprland")):
        ver = tool_version([binary, "--version"]) or pkg_version(binary.lower())
        r.ok(f"{binary} {ver} (the compositor the greeter runs in)".replace("  ", " "))
    else:
        r.err(f"{binary} is not installed, but greetd is set to start the greeter in it",
              f"install {binary.lower()}, or change --command in {GREETD_CONFIG}")

    r.ok(f"Python {sys.version.split()[0]}")
    if qt_module("QtMultimedia") is False:
        r.info("qt6-multimedia not installed (optional: live wallpapers play instead of showing a still)")
    for tool, why in (("matugen", "colors from wallpaper"), ("upower", "battery on the login screen"),
                      ("ffmpeg", "stills of live wallpapers when syncing"),
                      ("gdbus", "fingerprint reader detection"), ("niri", "checking the generated niri config")):
        if tool == "niri" and comp == "niri":
            continue
        if not shutil.which(tool):
            r.info(f"{tool} not installed (optional: {why})")


def check_files(r: Report, qml: Path):
    r.section("Greeter interface")
    if not (qml / "shell.qml").exists():
        r.err(f"no greeter UI at {qml}", "reinstall flamenco-greeter")
        return
    r.ok(f"UI at {qml}")
    broken = []
    for link in SHARED_LINKS:
        p = qml / link
        if not p.exists():
            target = os.readlink(p) if p.is_symlink() else "missing"
            broken.append(f"{link} → {target}")
    shell_dir = (qml / "Commons").resolve().parent
    if broken:
        r.err("links to Flamenco Shell are broken", "install flamenco-shell (the greeter uses its theme code)", broken)
    else:
        # the package version only describes the packaged copy, not a checkout linked by `make dev`
        v = pkg_version("flamenco-shell") if str(shell_dir).startswith("/usr/") else ""
        r.ok(f"Flamenco Shell {v + ' ' if v else ''}at {shell_dir}")
    ok, errors = qml_check(qml)
    if ok:
        r.ok("the interface loads (every QML file checked off-screen)")
    else:
        r.err("the interface fails to load, so the login screen would stay black",
              "update flamenco-greeter and flamenco-shell together; the errors say which file broke",
              errors)


def check_greetd(r: Report) -> dict:
    """Checks greetd's config and service; returns the launcher options it found."""
    r.section("greetd")
    opts: dict = {}
    if not GREETD_CONFIG.exists():
        r.err(f"{GREETD_CONFIG} is missing", "flamenco-greeter enable")
    else:
        try:
            conf = parse_greetd_config(GREETD_CONFIG.read_text())
        except Exception as e:   # tomllib.TOMLDecodeError and friends
            r.err(f"{GREETD_CONFIG} doesn't parse: {e}", "fix the syntax, or rewrite it with `flamenco-greeter enable`")
            conf = None
        if conf is not None:
            r.ok(f"{GREETD_CONFIG} parses")
            ds = conf.get("default_session") or {}
            command, user = str(ds.get("command", "")), str(ds.get("user", "greeter"))
            if not command:
                r.err("[default_session] has no command", "flamenco-greeter enable")
            elif "flamenco-greeter" not in command:
                r.warn(f"greetd runs `{command}`, not flamenco-greeter", "flamenco-greeter enable")
            else:
                opts = launcher_options(command)
                exe = opts["argv"][0] if opts["argv"] else ""
                if not (shutil.which(exe) or os.access(exe, os.X_OK)):
                    r.err(f"the command `{exe}` doesn't exist", f"fix the path in {GREETD_CONFIG}")
                if opts["compositor"] not in COMPOSITORS:
                    r.err(f"--command is `{opts['compositor'] or 'missing'}`; it must be niri, hyprland or sway",
                          f"fix the command in {GREETD_CONFIG}")
                else:
                    r.ok(f"runs flamenco-greeter in {opts['compositor']} as {user}")
                for key, flag in (("config", "-C"), ("path", "-p"), ("cache", "--cache-dir")):
                    if opts[key] and not Path(opts[key]).exists():
                        r.err(f"{flag} {opts[key]} doesn't exist", f"fix or remove {flag} in {GREETD_CONFIG}")
            try:
                pwd.getpwnam(user)
            except KeyError:
                r.err(f"the user greetd runs the greeter as ({user}) doesn't exist", "sudo systemd-sysusers")
            if "terminal" not in conf:
                r.warn("no [terminal] section (greetd needs vt = …)", "add `[terminal]` with `vt = 1`")

    if not shutil.which("systemctl"):
        r.info("no systemctl here; skipping service checks")
        return opts
    enabled = systemctl("is-enabled", "greetd.service")
    installed = enabled not in ("", "not-found")
    if enabled == "enabled":
        r.ok("greetd.service is enabled")
    elif not installed:
        r.err("greetd.service isn't installed", "sudo pacman -S greetd")
    else:
        r.err(f"greetd.service is {enabled}", "sudo systemctl enable -f greetd")
    dm = systemctl("show", "-p", "Id", "--value", "display-manager.service")
    if dm and dm not in ("greetd.service", "display-manager.service"):
        r.err(f"the display manager is {dm}, not greetd",
              f"sudo systemctl disable {dm.removesuffix('.service')} && sudo systemctl enable -f greetd")
    for other in OTHER_DMS:
        if f"{other}.service" != dm and systemctl("is-enabled", f"{other}.service") == "enabled":
            r.err(f"{other}.service is enabled too; two login screens fight over the display",
                  f"sudo systemctl disable {other}")
    if not installed:
        return opts
    props = dict(l.split("=", 1) for l in systemctl("show", "greetd.service", "-p", "ActiveState",
                                                     "-p", "SubState", "-p", "Result", "-p", "NRestarts").splitlines() if "=" in l)
    state = props.get("ActiveState", "")
    restarts = int(props.get("NRestarts", "0") or 0)
    if state == "active":
        r.ok("greetd is running" + (f" (restarted {restarts} times)" if restarts else ""))
    elif state:
        r.err(f"greetd is {state} ({props.get('SubState', '')}, result: {props.get('Result', '')})",
              "see the greetd log below, then: sudo systemctl restart greetd")
    lines = journal_lines(["-b", "-u", "greetd.service", "-p", "warning", "-n", "8"])
    if lines is None:
        r.info("greetd's log needs root: run `sudo flamenco-greeter doctor` to include it")
    elif lines:
        r.warn("greetd logged problems this boot", "", lines[-8:])
    return opts


def check_pam(r: Report, user: str):
    r.section("Authentication (PAM)")
    if not GREETD_PAM.exists():
        r.err(f"{GREETD_PAM} is missing, so nobody can log in", "reinstall greetd")
        return
    r.ok(f"{GREETD_PAM}")
    missing, seen = set(), set()

    def walk(path: Path, depth=0):
        if path in seen or depth > 5:
            return
        seen.add(path)
        if not path.exists():
            missing.add(f"included file {path.name}")
            return
        for raw in pam_lines(path):
            line = raw.split("#", 1)[0].strip()
            parts = line.split()
            if not parts:
                continue
            if parts[0].startswith("@include") and len(parts) > 1:
                walk(path.parent / parts[1], depth + 1)
                continue
            if len(parts) > 2 and parts[1] in ("include", "substack"):
                walk(path.parent / parts[2], depth + 1)
                continue
            optional = parts[0].startswith("-")
            for word in parts[2:] if len(parts) > 2 and not parts[1].startswith("[") else parts[1:]:
                if word.endswith(".so") and not optional:
                    if not (word.startswith("/") and Path(word).exists()) and not pam_module_path(Path(word).name):
                        missing.add(word)
                    break

    walk(GREETD_PAM)
    if missing:
        r.err("PAM refers to modules that aren't installed, so logins fail", "install them, or remove those lines",
              sorted(missing))
    else:
        r.ok("every PAM module it uses is installed")
    fp = fingerprint_state()
    if fp["pam"]:
        if not fp["fprintd"]:
            r.err("fingerprint login is configured, but fprintd isn't running", "sudo pacman -S fprintd")
        elif not fp["readers"]:
            r.warn("fingerprint login is configured, but no reader is found", "plug in or enable the reader")
        else:
            enrolled = fprint_enrolled(user)
            r.ok("fingerprint login" + (f"; {user} has fingers enrolled" if enrolled else ""))
            if enrolled is False:
                r.info(f"{user} has no fingers enrolled (fprintd-enroll)")
        if fp["outdated"]:
            r.warn("fingerprint settings are from an older version (passwords wait longer during a scan)",
                   "flamenco-greeter fingerprint enable")
    elif fp["readers"]:
        r.info("a fingerprint reader is available (flamenco-greeter fingerprint enable)")


def check_data(r: Report, cache: Path, user: str):
    r.section("Greeter user and data")
    try:
        g = pwd.getpwnam(GREETER_USER)
        r.ok(f"user {GREETER_USER} (uid {g.pw_uid})")
    except KeyError:
        r.err(f"user {GREETER_USER} doesn't exist", "sudo systemd-sysusers")
        g = None
    if not cache.is_dir():
        r.err(f"{cache} doesn't exist", "sudo systemd-tmpfiles --create")
        return
    st = cache.stat()
    owner = pwd.getpwuid(st.st_uid).pw_name if st.st_uid in [p.pw_uid for p in pwd.getpwall()] else str(st.st_uid)
    if g and st.st_uid != g.pw_uid:
        r.err(f"{cache} belongs to {owner}, so the greeter can't write to it",
              f"sudo chown -R {GREETER_USER}:{GREETER_USER} {cache}")
    elif st.st_mode & 0o070 != 0o070 and not (cache / "config.json").exists():
        r.warn(f"{cache} isn't group-writable (mode {oct(st.st_mode & 0o7777)})", f"sudo chmod 2770 {cache}")
    else:
        r.ok(f"{cache} (owned by {owner}, mode {oct(st.st_mode & 0o7777)})")
    if not can_read(cache):
        r.info(f"can't look inside {cache}: join the {GREETER_USER} group, or run with sudo")
        return
    users = cache / "users"
    synced = sorted(p.parent.name for p in users.glob("*/settings.json")) if can_read(users) else []
    mine = users / user / "settings.json"
    if user in synced:
        age = time.time() - mine.stat().st_mtime
        try:
            home = Path(pwd.getpwnam(user).pw_dir)
            newer = (home / ".config/flamenco/settings.json").stat().st_mtime > mine.stat().st_mtime
        except (KeyError, OSError):
            newer = False
        when = f"{int(age // 86400)} days ago" if age > 86400 else f"{int(age // 3600)} h ago" if age > 3600 else "recently"
        if newer:
            r.warn(f"{user}'s theme changed since the last sync ({when})", "flamenco-greeter sync")
        else:
            r.ok(f"{user}'s theme is synced ({when})")
        current = str((read_json(mine).get("wallpaper") or {}).get("current", ""))
        if current and is_video(Path(current)) and qt_module("QtMultimedia") is False:
            r.warn(f"{user}'s wallpaper is live, but Qt Multimedia isn't installed, so it shows a still",
                   "sudo pacman -S qt6-multimedia")
    else:
        r.warn(f"{user}'s theme isn't synced, so the login screen uses the default look", "flamenco-greeter sync")
    others = [u for u in synced if u != user]
    if others:
        r.info("also synced: " + ", ".join(others))
    widgets = read_json(cache / "state" / "widgets.json")
    n = len(widgets.get("widgets", []))
    r.info(f"{n} widget{'s' if n != 1 else ''} on the login screen" + (", editing locked" if widgets.get("locked") else ""))


def qt_module(name: str) -> bool | None:
    """Whether a Qt QML module (e.g. QtMultimedia) is installed; None when we can't tell."""
    roots = [Path(p) for p in os.environ.get("QML_IMPORT_PATH", "").split(":") if p]
    roots += [Path(p) for p in ("/usr/lib/qt6/qml", "/usr/lib64/qt6/qml", "/usr/lib/x86_64-linux-gnu/qt6/qml",
                                "/usr/lib/aarch64-linux-gnu/qt6/qml", "/run/current-system/sw/lib/qt-6/qml")]
    existing = [r for r in roots if r.is_dir()]
    if not existing:
        return None
    return any((r / name).is_dir() for r in existing)


def check_login_settings(r: Report, cache: Path):
    """Flamenco Shell's Settings → Lock & Login (config.json and its files)."""
    r.section("Flamenco Shell login settings")
    cfg_file = cache / "config.json"
    if not cache.exists():
        r.info(f"{cache} doesn't exist yet")
        return
    if not can_read(cache):
        r.info(f"can't look inside {cache}: join the {GREETER_USER} group, or run with sudo")
        return
    if not cfg_file.exists():
        r.info("nothing applied from Flamenco Shell yet (Settings → Lock & Login → Apply); the greeter uses synced themes and its defaults")
        return
    try:
        cfg = json.loads(cfg_file.read_text())
    except (OSError, ValueError) as e:
        r.err(f"{cfg_file} doesn't parse ({e}), so it's ignored", "apply again from Settings → Lock & Login")
        return
    when = time.strftime("%a %d %b %H:%M", time.localtime(cfg_file.stat().st_mtime))
    r.ok(f"applied {when} by {cfg.get('generator', 'Flamenco Shell')}")
    if cfg.get("version", 1) > 1:
        r.warn(f"config.json is version {cfg['version']}, newer than this greeter knows (1)", "update flamenco-greeter")
    wp = cfg.get("wallpaper") or {}
    missing = [n for n in [wp.get("file"), wp.get("live")] + list((cfg.get("users") or {}).get("avatars", {}).values())
               if n and not (cache / n).is_file()]
    if missing:
        r.err("files it refers to are missing", "apply again from Settings → Lock & Login", missing)
    if wp.get("mode") == "image" and wp.get("file") not in missing:
        kind = "live wallpaper" if wp.get("live") or str(wp.get("file", "")).lower().endswith(".gif") else "wallpaper"
        r.ok(f"login {kind}: {wp.get('file')}" + (f" + {wp['live']}" if wp.get("live") else "")
             + f" ({wp.get('source', 'custom')}, blur {wp.get('blur', 0)}, dim {wp.get('dim', 0)})")
    elif wp.get("mode") == "color":
        r.ok(f"login background: {wp.get('color', '')}")
    if wp.get("live") and qt_module("QtMultimedia") is False:
        r.warn("the login wallpaper is live, but Qt Multimedia isn't installed, so it shows a still",
               "sudo pacman -S qt6-multimedia")
    s, u = cfg.get("sessions") or {}, cfg.get("users") or {}
    opts = [("session picker", s.get("picker", True)), ("user list", u.get("list", True)),
            ("power buttons", (cfg.get("power") or {}).get("buttons", True)),
            ("fingerprint", (cfg.get("auth") or {}).get("fingerprint", False))]
    r.info(", ".join(f"{name} {'on' if on else 'off'}" for name, on in opts)
           + (f"; default session {s['default']}" if s.get("default") else ""))
    if (cfg.get("auth") or {}).get("fingerprint") and not pam_has_module(GREETD_PAM, "pam_fprintd"):
        r.warn("fingerprint login is on in Lock & Login, but greetd's PAM doesn't use pam_fprintd",
               "flamenco-greeter fingerprint enable")



def check_compositor(r: Report, opts: dict, cache: Path, qml: Path):
    r.section("Compositor and display")
    comp = opts.get("compositor") or "niri"
    settings = read_json(cache / "config" / "flamenco" / "settings.json") if can_read(cache) else {}
    kb = settings.get("keyboard") or {}
    base = ""
    if opts.get("config"):
        try:
            base = Path(opts["config"]).read_text()
        except OSError:
            pass
    if comp == "niri" and shutil.which("niri"):
        with tempfile.TemporaryDirectory(prefix="flamenco-greeter-doctor-") as tmp:
            cfg = Path(tmp) / "niri.kdl"
            cfg.write_text(niri_config(base, f"sh {tmp}/run-greeter.sh", kb, None))
            problem = niri_invalid(cfg)
        if problem:
            r.err("the niri config the launcher writes is invalid", "check -C and /etc/greetd/flamenco-niri.kdl", [problem])
        else:
            r.ok("the niri config the launcher writes is valid")
        for o in NIRI_OVERRIDES:
            if Path(o).exists():
                r.info(f"includes {o}")
    elif comp == "sway" and shutil.which("sway"):
        with tempfile.TemporaryDirectory(prefix="flamenco-greeter-doctor-") as tmp:
            cfg = Path(tmp) / "sway.conf"
            cfg.write_text(sway_config(base, "true", kb))
            code, out, err = run_out(["sway", "-C", "-c", str(cfg)])
        if code == 0:
            r.ok("the sway config the launcher writes is valid")
        else:
            r.err("the sway config the launcher writes is invalid", "check -C", (out + "\n" + err).strip().splitlines()[-3:])
    else:
        r.info(f"{comp}: config not checked")
    if shutil.which("loginctl"):
        graphical = run_out(["loginctl", "show-seat", "seat0", "-p", "CanGraphical", "--value"])[1]
        if graphical == "yes":
            r.ok("seat0 has a display")
        elif graphical:
            r.err("seat0 has no usable display (GPU driver not loaded?)", "check `ls /dev/dri` and your GPU driver")
    if not list(Path("/dev/dri").glob("card*")):
        r.err("no GPU device in /dev/dri", "check your GPU driver (e.g. nvidia-drm.modeset=1 for NVIDIA)")


def check_sessions(r: Report, cache: Path):
    r.section("Desktop sessions")
    sessions = list_sessions()
    if not sessions:
        r.err("no desktop sessions are installed, so there's nothing to log in to",
              "install one (niri ships niri.desktop in /usr/share/wayland-sessions)")
        return
    r.ok(f"{len(sessions)} session{'s' if len(sessions) != 1 else ''}: " + ", ".join(s["name"] for s in sessions))
    for s in sessions:
        exe = s["command"][0]
        if s["type"] == "x11":
            exe = s["command"][2] if len(s["command"]) > 2 else exe
        if not (shutil.which(exe) or os.access(exe, os.X_OK)):
            r.warn(f"{s['name']} starts `{exe}`, which isn't installed", "remove the session or install it")


def check_history(r: Report, opts: dict, cache: Path):
    r.section("Recent trouble")
    clean = True
    if not (cache / "state").exists():
        pass   # never started yet
    elif can_read(cache / "state"):
        crashes = crash_times(cache)
        recent = [t for t in crashes if time.time() - t < 3600]
        if recent:
            clean = False
            r.err(f"the login screen crashed {len(recent)} time{'s' if len(recent) != 1 else ''} in the last hour",
                  "the interface check above usually says why")
        try:
            last = (cache / "state" / "fallback").read_text().strip().splitlines()[-1]
            ts, why = last.split(" ", 1)
            if time.time() - int(ts) < 86400 * 2:
                clean = False
                r.warn(f"fell back to a text login {time.strftime('%a %H:%M', time.localtime(int(ts)))}: {why}",
                       "fix what's reported above, then: sudo systemctl restart greetd")
        except (OSError, ValueError, IndexError):
            pass
    else:
        r.info("can't read the crash history (run with sudo)")
    comp = opts.get("compositor") or "niri"
    lines = journal_lines(["-b", "-t", f"flamenco-greeter/{comp}", "-n", "400"])
    if lines is None:
        r.info("the greeter's log needs root: run `sudo flamenco-greeter doctor` to include it")
    else:
        noise = ("MESA", "color scheme", "settings.json", "dropped operation", "window masks")
        bad = [l for l in lines if re.search(r"ERROR|caused by|panic|error:|Failed", l) and not any(n in l for n in noise)]
        if bad:
            clean = False
            r.warn("the greeter logged errors this boot", f"full log: journalctl -b -t flamenco-greeter/{comp}", bad[-8:])
    if clean:
        r.ok("no crashes or fallbacks recorded")


def cmd_doctor(args: list[str]) -> int:
    report = Report()
    user = doctor_user()
    opts = {}
    sections = [
        ("greetd", lambda: opts.update(check_greetd(report))),
        ("dependencies", lambda: check_dependencies(report, opts)),
        ("files", lambda: check_files(report, Path(opts["path"]) if opts.get("path") else greeter_dir())),
        ("pam", lambda: check_pam(report, user)),
        ("data", lambda: check_data(report, Path(opts.get("cache") or DEFAULT_CACHE), user)),
        ("login settings", lambda: check_login_settings(report, Path(opts.get("cache") or DEFAULT_CACHE))),
        ("compositor", lambda: check_compositor(report, opts, Path(opts.get("cache") or DEFAULT_CACHE),
                                                Path(opts["path"]) if opts.get("path") else greeter_dir())),
        ("sessions", lambda: check_sessions(report, Path(opts.get("cache") or DEFAULT_CACHE))),
        ("history", lambda: check_history(report, opts, Path(opts.get("cache") or DEFAULT_CACHE))),
    ]
    for name, fn in sections:
        try:
            fn()
        except Exception as e:   # one broken check shouldn't hide the rest
            if not report.sections:
                report.section(name)
            report.err(f"couldn't check {name}: {e}")
    # greetd is checked first to learn the launcher options, but dependencies read better at the top
    if len(report.sections) > 1 and report.sections[1]["title"] == "Dependencies":
        report.sections.insert(0, report.sections.pop(1))

    errors, warnings = report.count("err"), report.count("warn")
    if "--json" in args:
        print(json.dumps({"version": VERSION, "errors": errors, "warnings": warnings, "sections": report.sections}, indent=2))
        return 1 if errors else 0
    color = sys.stdout.isatty()
    print(f"Flamenco Greeter {VERSION} · doctor" + (" (as root)" if os.geteuid() == 0 else ""))
    report.print(color)
    print()
    if errors:
        print(f"{errors} problem{'s' if errors != 1 else ''}, {warnings} warning{'s' if warnings != 1 else ''}. "
              "Fix the ✗ items above, then restart the login screen: sudo systemctl restart greetd")
    elif warnings:
        print(f"No problems, {warnings} warning{'s' if warnings != 1 else ''}.")
    else:
        print("Everything looks right.")
    return 1 if errors else 0


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = args[0], args[1:]
    if cmd in ("-V", "--version", "version"):
        print(f"flamenco-greeter {VERSION}")
        return 0
    if cmd == "users":
        print(json.dumps(list_users(cache_dir())))
        return 0
    if cmd == "sessions":
        print(json.dumps(list_sessions()))
        return 0
    if cmd == "sync":
        return cmd_sync(rest)
    if cmd == "fingerprint":
        return cmd_fingerprint(rest)
    if cmd == "enable":
        return cmd_enable(rest)
    if cmd == "preview":
        return cmd_preview(rest)
    if cmd in ("doctor", "check"):
        return cmd_doctor(rest)
    if cmd == "widgets":
        return cmd_widgets(rest)
    if cmd.startswith("-"):
        return cmd_launch(args)
    print(__doc__)
    return die(f"unknown command {cmd}")


if __name__ == "__main__":
    sys.exit(main())
