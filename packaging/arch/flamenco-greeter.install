post_install() {
    echo ">> Flamenco Greeter installed."
    echo ">>   flamenco-greeter enable   make greetd (with the Flamenco greeter) the display manager"
    echo ">>   flamenco-greeter sync     bring your theme, wallpaper and avatar to the login screen"
    echo ">>   flamenco-greeter preview  try it in a window first"
    echo ">>   flamenco-greeter fingerprint enable   log in with a fingerprint (needs fprintd)"
    echo ">>   flamenco-greeter doctor   check the setup"
}

post_upgrade() {
    # refresh the fingerprint block flamenco-greeter manages in /etc/pam.d/greetd (no-op when current)
    if grep -q "BEGIN flamenco-greeter fingerprint" /etc/pam.d/greetd 2>/dev/null; then
        flamenco-greeter fingerprint enable
    fi
    echo ">> Flamenco Greeter upgraded. The new version shows at the next login screen."
}
